# ===== Servidor =====
PORT=4000

# Origenes que pueden llamar a la API, separados por coma.
# En produccion pon aqui SOLO la URL del sitio publicado.
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ===== Sesion =====
# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_DURACION=8h

# ===== Administrador =====
ADMIN_USUARIO=admin

# Recomendado: guarda el hash, no la clave.  npm run hash
# Va entre comillas simples porque el hash lleva signos $
ADMIN_CLAVE_HASH=

# Alternativa para empezar rapido: clave en texto plano (usa una de las dos).
ADMIN_CLAVE=

# ===== Imagenes =====
# Tamano maximo del archivo que se sube (se optimiza a WebP al recibirlo)
MAX_IMAGEN_MB=8

# --- Supabase Storage (recomendado: mismo proyecto que la base de datos) ---
# URL del proyecto:  Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=
# Clave secreta del proyecto. Dos formatos validos:
#   - Recomendada: Project Settings -> API Keys -> pestana "Publishable and secret
#     API keys" -> crear una Secret key (empieza por sb_secret_). Se puede revocar
#     por separado y las legacy se deprecan a finales de 2026.
#   - Legacy: la clave service_role (un JWT largo), en la otra pestana.
# Nunca la anon/publishable: no puede escribir en Storage.
# Es secreta: da acceso total al proyecto y nunca debe llegar al navegador.
SUPABASE_SERVICE_KEY=
# Bucket donde se guardan las fotos. Se crea solo la primera vez, publico.
SUPABASE_BUCKET=catalogo

# --- Cloudinary (alternativa; solo se usa si no hay Supabase configurado) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Si no se configura ninguno, las imagenes se guardan en backend/uploads
# (solo desarrollo: en Render ese disco se vacia en cada despliegue).

# ===== Base de datos =====
# Cadena de conexion de Supabase (Project Settings -> Database -> Connection string).
#
# Usa el "Session pooler" (IPv4, pensado para servidores siempre encendidos como este):
#   postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# El "Transaction pooler" (mismo host, puerto 6543) tambien funciona.
# La conexion directa (db.PROYECTO.supabase.co) solo resuelve por IPv6 y Render no la alcanza.
DATABASE_URL=

# Opcional pero recomendado: certificado de la autoridad certificadora de Supabase,
# para verificar el servidor y no solo cifrar.
#   Supabase -> Project Settings -> Database -> SSL Configuration -> Download certificate
#   Guardalo, por ejemplo, en backend/certs/supabase.crt
# Sin esto la conexion va cifrada igual, pero sin verificar el certificado (y se avisa al arrancar).
DB_SSL_CA=
